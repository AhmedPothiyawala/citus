{
  "name": "citiuscomm-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=4174",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test",
    "test:unit:stress": "for i in $(seq 1 25); do vitest run tests/unit/Site.test.tsx --reporter=dot || exit 1; done",
    "test:unit:100": "vitest run tests/unit/Stress100.test.tsx",
    "test:e2e:stress": "playwright test tests/e2e/site.spec.ts --repeat-each=5",
    "test:pages:stress": "playwright test tests/e2e/site.spec.ts --repeat-each=10",
    "test:page:100": "playwright test tests/e2e/site.spec.ts --repeat-each=100 -g",
    "test:full:100": "npm run test:unit:100 && playwright test tests/e2e/site.spec.ts --repeat-each=100",
    "test:stress": "npm run test:unit:100 && npm run test:pages:stress",
    "test:sanity": "npx tsx scripts/full-sanity-check.ts && npm run lint && npm test && npm run test:unit:100",
    "verify": "npm run test:sanity && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
